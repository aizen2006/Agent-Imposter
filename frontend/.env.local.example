# OpenAI — drives the agents via LangChain (src/agents/brain.ts)
OPENAI_API_KEY=sk-...

# Optional model overrides. Actions are a 5-way choice fired 6x in parallel
# every round, so they run on the small fast model; meeting dialogue is the
# product and runs on the larger one.
OPENAI_ACTION_MODEL=gpt-4o-mini
OPENAI_DIALOGUE_MODEL=gpt-4o
LLM_TIMEOUT_MS=8000

# Monad testnet — contract/deployed.json is the record of truth
NEXT_PUBLIC_CONTRACT_ADDRESS=0xFc7AcE219951bE036ED78C2c8D1B338107AdD7d9

# Wallet that signs createGame / resolve. Currently the deployer account.
RESOLVER_PK=

# Shared matches, the lobby and the leaderboard (prd.md §15).
# Create a Blob store in the Vercel dashboard and paste its token here.
# Without it every match plays only in the tab that generated it, the lobby
# is empty, and the leaderboard has nothing to rank — the app still runs.
# Locally, matches fall back to a directory in the OS temp dir instead, so
# you can develop all of this without provisioning anything.
BLOB_READ_WRITE_TOKEN=
